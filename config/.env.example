# Base example configuration for the internal logistics application.
# Copy this file to `.env` for local startup or translate the values
# into environment variables managed by your deployment tooling.

LOGISTICS_APP_ENVIRONMENT=development

# Database
LOGISTICS_APP_DATABASE__HOST=localhost
LOGISTICS_APP_DATABASE__PORT=5432
LOGISTICS_APP_DATABASE__DATABASE_NAME=logistics_app
LOGISTICS_APP_DATABASE__USERNAME=logistics_user
LOGISTICS_APP_DATABASE__PASSWORD=change_me
LOGISTICS_APP_DATABASE__ECHO_SQL=false
LOGISTICS_APP_DATABASE__POOL_SIZE=10
LOGISTICS_APP_DATABASE__MAX_OVERFLOW=20

# Storage
LOGISTICS_APP_STORAGE__DOCUMENTS_ROOT=C:/ProgramData/InternalLogistics/documents
LOGISTICS_APP_STORAGE__TEMPORARY_FILES_ROOT=C:/ProgramData/InternalLogistics/temp
LOGISTICS_APP_STORAGE__EXPORTS_ROOT=C:/ProgramData/InternalLogistics/exports

# Printers
LOGISTICS_APP_PRINTERS__SPOOLER_BACKEND=windows
LOGISTICS_APP_PRINTERS__JOB_TIMEOUT_SECONDS=60
LOGISTICS_APP_PRINTERS__ALLOW_DIRECT_PRINT=true
LOGISTICS_APP_PRINTERS__DEFAULTS__WAREHOUSE_MAIN_PRINTER=Warehouse_Main_Printer
LOGISTICS_APP_PRINTERS__DEFAULTS__LOADING_DOCK_PRINTER=Loading_Dock_Printer
LOGISTICS_APP_PRINTERS__DEFAULTS__OFFICE_PRINTER=Office_Printer
LOGISTICS_APP_PRINTERS__DEFAULTS__LABEL_PRINTER=Label_Printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__PACKING_SLIP=warehouse_main_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__CMR=warehouse_main_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__SIGNED_CMR=office_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__CERTIFICATE=office_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__STICKER=label_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__TRANSPORT_DOCUMENT=warehouse_main_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__OTHER=office_printer

# API
LOGISTICS_APP_API__HOST=0.0.0.0
LOGISTICS_APP_API__PORT=8000
LOGISTICS_APP_API__BASE_URL=http://localhost:8000
LOGISTICS_APP_API__REQUEST_TIMEOUT_SECONDS=30

# Desktop client
LOGISTICS_APP_DESKTOP__COMPANY_DISPLAY_NAME=Internal Logistics
LOGISTICS_APP_DESKTOP__DEFAULT_LANGUAGE=en
LOGISTICS_APP_DESKTOP__THEME_NAME=enterprise_light

# Logging
LOGISTICS_APP_LOGGING__LEVEL=INFO
LOGISTICS_APP_LOGGING__PERSIST_APPLICATION_LOGS=true
LOGISTICS_APP_LOGGING__APPLICATION_LOGGER_NAME=logistics_app
