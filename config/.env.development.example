# Example development environment configuration.
# Intended for a local workstation or developer VM.

LOGISTICS_APP_ENVIRONMENT=development
LOGISTICS_APP_DATABASE__HOST=localhost
LOGISTICS_APP_DATABASE__PORT=5432
LOGISTICS_APP_DATABASE__DATABASE_NAME=logistics_app_dev
LOGISTICS_APP_DATABASE__USERNAME=logistics_app_dev
LOGISTICS_APP_DATABASE__PASSWORD=change_me
LOGISTICS_APP_STORAGE__DOCUMENTS_ROOT=C:/LogisticsDev/documents
LOGISTICS_APP_STORAGE__TEMPORARY_FILES_ROOT=C:/LogisticsDev/temp
LOGISTICS_APP_STORAGE__EXPORTS_ROOT=C:/LogisticsDev/exports
LOGISTICS_APP_PRINTERS__DEFAULTS__WAREHOUSE_MAIN_PRINTER=DEV_Warehouse_Printer
LOGISTICS_APP_PRINTERS__DEFAULTS__LOADING_DOCK_PRINTER=DEV_Loading_Dock_Printer
LOGISTICS_APP_PRINTERS__DEFAULTS__OFFICE_PRINTER=DEV_Office_Printer
LOGISTICS_APP_PRINTERS__DEFAULTS__LABEL_PRINTER=DEV_Label_Printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__PACKING_SLIP=warehouse_main_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__CMR=warehouse_main_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__SIGNED_CMR=office_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__CERTIFICATE=office_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__STICKER=label_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__TRANSPORT_DOCUMENT=warehouse_main_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__OTHER=office_printer
LOGISTICS_APP_API__BASE_URL=http://localhost:8000
LOGISTICS_APP_LOGGING__LEVEL=DEBUG
