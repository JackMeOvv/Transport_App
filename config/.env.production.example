# Example production configuration.
# Replace placeholder values with company-managed infrastructure details.

LOGISTICS_APP_ENVIRONMENT=production
LOGISTICS_APP_DATABASE__HOST=db-server.internal.example
LOGISTICS_APP_DATABASE__PORT=5432
LOGISTICS_APP_DATABASE__DATABASE_NAME=logistics_app
LOGISTICS_APP_DATABASE__USERNAME=logistics_service
LOGISTICS_APP_DATABASE__PASSWORD=replace_with_secret
LOGISTICS_APP_DATABASE__POOL_SIZE=20
LOGISTICS_APP_DATABASE__MAX_OVERFLOW=40
LOGISTICS_APP_STORAGE__DOCUMENTS_ROOT=D:/InternalLogistics/Documents
LOGISTICS_APP_STORAGE__TEMPORARY_FILES_ROOT=D:/InternalLogistics/Temp
LOGISTICS_APP_STORAGE__EXPORTS_ROOT=D:/InternalLogistics/Exports
LOGISTICS_APP_PRINTERS__DEFAULTS__WAREHOUSE_MAIN_PRINTER=Warehouse_Main_01
LOGISTICS_APP_PRINTERS__DEFAULTS__LOADING_DOCK_PRINTER=Loading_Dock_01
LOGISTICS_APP_PRINTERS__DEFAULTS__OFFICE_PRINTER=Transport_Office_01
LOGISTICS_APP_PRINTERS__DEFAULTS__LABEL_PRINTER=Warehouse_Label_01
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__PACKING_SLIP=warehouse_main_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__CMR=warehouse_main_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__SIGNED_CMR=office_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__CERTIFICATE=office_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__STICKER=label_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__TRANSPORT_DOCUMENT=warehouse_main_printer
LOGISTICS_APP_PRINTERS__DOCUMENT_TYPE_MAPPING__OTHER=office_printer
LOGISTICS_APP_API__HOST=0.0.0.0
LOGISTICS_APP_API__PORT=8000
LOGISTICS_APP_API__BASE_URL=http://logistics-api.internal.example:8000
LOGISTICS_APP_LOGGING__LEVEL=INFO
